<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.4</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.ditis</groupId>
	<artifactId>recp</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>recp</name>
	<description>RECP dev project july 2025</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>17</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		
		<!-- https://mvnrepository.com/artifact/org.springframework.boot/spring-boot-starter-thymeleaf -->
		<dependency>
		    <groupId>org.springframework.boot</groupId>
		    <artifactId>spring-boot-starter-thymeleaf</artifactId>
		    <version>4.0.0-M1</version>
		</dependency>
		
		
		 <!-- SQLite JDBC Driver -->
		   <dependency>
		       <groupId>org.xerial</groupId>
		       <artifactId>sqlite-jdbc</artifactId>
		       <version>3.34.0</version>
		   </dependency>
		
		   <dependency>
		    	<groupId>org.hibernate.orm</groupId>
		    	<artifactId>hibernate-community-dialects</artifactId>
		   </dependency>
		
		   <!-- Spring Boot Starter Data JPA -->
		   <dependency>
		       <groupId>org.springframework.boot</groupId>
		       <artifactId>spring-boot-starter-data-jpa</artifactId>
		   </dependency>
		   
		   <!-- https://mvnrepository.com/artifact/org.apache.commons/commons-lang3 -->
		   <dependency>
			    <groupId>org.apache.commons</groupId>
			    <artifactId>commons-lang3</artifactId>
			    <version>3.18.0</version>
			</dependency>
			
			<!-- https://mvnrepository.com/artifact/commons-io/commons-io -->
			<dependency>
			    <groupId>commons-io</groupId>
			    <artifactId>commons-io</artifactId>
			    <version>2.20.0</version>
			</dependency>
			
			<!-- Ingescape-related Configurations -->
			
			<dependency>
			    <groupId>com.ingescape</groupId>
			    <artifactId>ingescape</artifactId>
			    <version>1.0</version>
			    <scope>system</scope>
			    <systemPath>${project.basedir}/JARLibraries/ingescape.jar</systemPath>
			</dependency>
			
			<dependency>
			    <groupId>okhttp3</groupId>
			    <artifactId>okhttp-4.9.0</artifactId>
			    <version>1.0</version>
			    <scope>system</scope>
			    <systemPath>${project.basedir}/JARLibraries/okhttp-4.9.0.jar</systemPath>
			</dependency>
			
			<dependency>
			    <groupId>com.google.gson</groupId>
			    <artifactId>com.google.gson</artifactId>
			    <version>1.0</version>
			    <scope>system</scope>
			    <systemPath>${project.basedir}/JARLibraries/gson-2.8.6.jar</systemPath>
			</dependency>
			
			<dependency>
			    <groupId>kotlin</groupId>
			    <artifactId>kotlin-stdlib</artifactId>
			    <version>1.0</version>
			    <scope>system</scope>
			    <systemPath>${project.basedir}/JARLibraries/kotlin-stdlib-1.4.0.jar</systemPath>
			</dependency>
			
			<dependency>
			    <groupId>okio</groupId>
			    <artifactId>kotlin-stdlib</artifactId>
			    <version>1.0</version>
			    <scope>system</scope>
			    <systemPath>${project.basedir}/JARLibraries/okio-2.8.0.jar</systemPath>
			</dependency>
			
			<dependency>
			    <groupId>okio</groupId>
			    <artifactId>kotlin-stdlib</artifactId>
			    <version>1.0</version>
			    <scope>system</scope>
			    <systemPath>${project.basedir}/JARLibraries/okio-2.8.0.jar</systemPath>
			</dependency>
			
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
